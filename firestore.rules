rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Staff = two technical Firebase Auth accounts (nobody types an email: the
    //    site's password-only login uses them behind the scenes). See SECURITY.md.
    function isAdmin()  { return request.auth != null && request.auth.token.email == 'admin@catalog.invalid'; }
    function isEditor() { return request.auth != null && request.auth.token.email == 'editor@catalog.invalid'; }
    function isStaff()  { return isAdmin() || isEditor(); }
    function str(v, max) { return v is string && v.size() <= max; }

    // Catalog structure + per-model parts + news + broadcast:
    // readable by everyone (the site loads them before login); written only by staff.
    match /catalog/{doc} {
      allow read: if true;
      allow create, update: if isStaff();
      allow delete: if false;
    }
    match /parts/{doc}  { allow read: if true; allow write: if isStaff(); }
    match /news/{doc}   { allow read: if true; allow write: if isStaff(); }
    match /system/{doc} { allow read: if true; allow write: if isStaff(); }

    // Staff only: activity log, alerts, restore points.
    match /history/{doc}   { allow read, write: if isStaff(); }
    match /alerts/{doc}    { allow read, write: if isStaff(); }
    match /snapshots/{doc} { allow read, write: if isStaff(); }

    // Anyone (viewers too) may SUBMIT an error report / missing-model request.
    // Only staff can read, resolve or delete them.
    match /reports/{doc} {
      allow create: if request.resource.data.keys().hasOnly(['bid','cid','mid','modelName','brandName','text','role','ts','resolved'])
                    && request.resource.data.keys().hasAll(['text','ts','resolved'])
                    && str(request.resource.data.text, 2000)
                    && request.resource.data.resolved == false
                    && request.resource.data.ts == request.time;
      allow read, update, delete: if isStaff();
    }
    match /techRequests/{doc} {
      allow create: if request.resource.data.keys().hasOnly(['text','submittedBy','role','ts','resolved'])
                    && request.resource.data.keys().hasAll(['text','ts','resolved'])
                    && str(request.resource.data.text, 2000)
                    && request.resource.data.resolved == false
                    && request.resource.data.ts == request.time;
      allow read, update, delete: if isStaff();
    }

    // Per-model view counter: anyone may add exactly +1.
    match /views/{id} {
      allow get: if true;
      allow list, delete: if isStaff();
      allow create: if request.resource.data.keys().hasOnly(['count','modelName','brandName','lastSeen'])
                    && request.resource.data.count == 1;
      allow update: if request.resource.data.keys().hasOnly(['count','modelName','brandName','lastSeen'])
                    && request.resource.data.count == resource.data.count + 1;
    }

    // Everything else: closed.
    match /{document=**} { allow read, write: if false; }
  }
}
